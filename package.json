    "husky": "^8.0.0",
    "lerna": "^3.22.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.1.0",
    "sass": "^1.51.0",
    "sass-loader": "^10.2.1",
    "semver": "^6.3.0",
    "stylus": "^0.54.8",
    "stylus-loader": "^4.3.3",
    "svg-inline-loader": "^0.8.2",
    "typescript": "~5.5.2",
    "webpack": "^5.88.2"
  },
  "devDependencies": {
