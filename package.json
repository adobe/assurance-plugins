{
  "name": "assurance-plugins",
  "version": "1.0.0",
  "description": "This is a location for Assurance plugins and tools for creating Assurance plugins",
  "main": "index.js",
  "repository": "https://github.com/adobe/assurance-plugins",
  "author": "Adobe Systems",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "yarn": ">=1.16.0",
    "node": ">=18.13.0"
  },
  "scripts": {
    "generate": "create-plugin-package && yarn",
    "storybook": "storybook dev -p 6006",
    "build": "npx nx run-many --projects='packages/components/*' -t build",
    "docs": "npx nx dev docs",
    "dev": "npx nx start",
    "format": "prettier packages/**/*.{ts,tsx,js} --write",
    "test": "vitest run",
    "test:ui": "vitest --ui"
  },
  "workspaces": {
    "packages": [
      "packages/common/*",
      "packages/ui-plugins/*",
      "packages/components/*"
    ]
  },
  "dependencies": {
    "@adobe/react-spectrum": "^3.36.3",
